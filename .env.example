# Application
NODE_ENV=development
APP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters

# PostgreSQL
POSTGRES_PORT=5545
DATABASE_URL=postgresql://syntavera:syntavera-local-only@localhost:5545/syntavera?schema=public

# Email (SMTP)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=SyntaVera <no-reply@syntavera.dev>
CONTACT_NOTIFICATION_TO=

# Private S3-compatible storage (Cloudflare R2 in production)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=syntavera-private
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
SIGNED_URL_TTL_SECONDS=300
MAX_UPLOAD_BYTES=26214400

# Privacy gate. Set only after approved legal copy is installed.
PRIVACY_POLICY_VERSION=
PUBLIC_CONTACT_ENABLED=false

# Explicit local bootstrap. Never enable with production-like shared data.
ALLOW_DEMO_SEED=false
SEED_ADMIN_NAME=Administrador local
SEED_ADMIN_EMAIL=admin@syntavera.dev
SEED_ADMIN_PASSWORD=

# Rate limiting
CONTACT_RATE_LIMIT_WINDOW_SECONDS=3600
CONTACT_RATE_LIMIT_MAX=5
